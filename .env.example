# Copy to .env and add your key. Sol is the external model that mines Gemma's
# failures and proposes harness edits — see docs/research/self-evolving-harness/
# todo-begin-self-improvement-loop.md for the full convention.

# Via OpenRouter (model slug verified against OpenRouter's catalog, 2026-07-11):
SOL_BASE_URL=https://openrouter.ai/api/v1
SOL_MODEL=openai/gpt-5.6-sol
SOL_API_KEY=sk-or-...

# Direct OpenAI account instead (adjust base_url/model to your actual endpoint):
# SOL_BASE_URL=https://api.openai.com/v1
# SOL_MODEL=gpt-5.6-sol
# SOL_API_KEY=sk-...
